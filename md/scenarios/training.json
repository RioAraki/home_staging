  "tutorial": {
    "steps": [
      {
        "id": "drag-bed", "text": "按住家具，拖进户型图", "hand": "drag",
        "pointTo": { "kind": "dragPath", "fromCard": 0, "to": [4, 5] },
        "gate": { "action": "drag", "cardIndex": 0 },
        "advanceOn": { "on": "ghostPositioned" }
      },
      {
        "id": "place-bed", "text": "按「放置」把它固定下来", "hand": "tap",
        "pointTo": { "kind": "button", "name": "放置" },
        "gate": { "action": "place", "cardIndex": 0,
          "fixedGoal": { "cardIndex": 0, "rotation": 0, "origin": [4, 5] } },
        "advanceOn": { "on": "placed" }
      },
      {
        "id": "drag-sofa", "text": "再拖一个沙发进来", "hand": "drag",
        "pointTo": { "kind": "dragPath", "fromCard": 1, "to": [6, 5] },
        "gate": { "action": "drag", "cardIndex": 1 },
        "advanceOn": { "on": "ghostPositioned" }
      },
      {
        "id": "rotate-sofa", "text": "点一下家具可以旋转——连点 3 次，把沙发转成高亮的样子（床的正下方）", "hand": "rotate",
        "pointTo": { "kind": "goal", "cardIndex": 1, "rotation": 3, "origin": [6, 5] },
        "gate": { "action": "rotate", "minTimes": 3 },
        "advanceOn": { "on": "rotatedAtLeast", "times": 3 }
      },
      {
        "id": "place-sofa", "text": "按「放置」固定沙发", "hand": "tap",
        "pointTo": { "kind": "button", "name": "放置" },
        "gate": { "action": "place", "cardIndex": 1, "cell": [6, 5],
          "fixedGoal": { "cardIndex": 1, "rotation": 3, "origin": [6, 5] } },
        "advanceOn": { "on": "placed" }
      },
      {
        "id": "explain-open", "text": "家具旁的圆点是「开放格」：这一格不能被占用，而且要能连到房间出口。床和沙发旁都有这样的格子。", "hand": "tap",
        "pointTo": { "kind": "openCells" },
        "gate": { "action": "none" },
        "advanceOn": { "on": "confirm" }
      },
      {
        "id": "drag-table", "text": "拖来一个桌椅组合，放到沙发旁边", "hand": "drag",
        "pointTo": { "kind": "dragPath", "fromCard": 2, "to": [6, 6] },
        "gate": { "action": "drag", "cardIndex": 2 },
        "advanceOn": { "on": "ghostPositioned" }
      },
      {
        "id": "rotate-table", "text": "桌椅的开放格默认朝下——连点 2 次让它朝上，才能和沙发共用开放格", "hand": "rotate",
        "pointTo": { "kind": "goal", "cardIndex": 2, "rotation": 2, "origin": [6, 6] },
        "gate": { "action": "rotate", "minTimes": 2 },
        "advanceOn": { "on": "rotatedAtLeast", "times": 2 }
      },
      {
        "id": "place-table", "text": "把桌椅对齐到高亮处，按「放置」——它和沙发共用一个开放格", "hand": "tap",
        "pointTo": { "kind": "button", "name": "放置" },
        "gate": { "action": "place", "cardIndex": 2, "requireShare": true,
          "fixedGoal": { "cardIndex": 2, "rotation": 2, "origin": [6, 6] } },
        "advanceOn": { "on": "placed", "sharesOpenCell": true }
      },
      {
        "id": "plant-cover-open", "text": "家具不能压住别的家具的开放格！把粉植物拖去盖住桌椅旁的这两个圆点试试——变红就是放不下", "hand": "drag",
        "pointTo": { "kind": "badCell", "cell": [6, 6], "bbox": [1, 2], "fromCard": 4 },
        "gate": { "action": "drag", "cardIndex": 4 },
        "advanceOn": { "on": "ackCovers", "cell": [6, 7] }
      },
      {
        "id": "plant-rotate-vert", "text": "还有一种放不下：先点一下，把粉植物转成竖着的", "hand": "rotate",
        "pointTo": { "kind": "ghost" },
        "gate": { "action": "rotate", "minTimes": 1 },
        "advanceOn": { "on": "rotatedAtLeast", "times": 1 }
      },
      {
        "id": "plant-block-door", "text": "把竖着的粉植物拖到大门内侧的这两格——它会切断所有家具开放格通往大门的路，同样放不下（变红）", "hand": "drag",
        "pointTo": { "kind": "badCell", "cell": [5, 8], "bbox": [2, 1] },
        "gate": { "action": "drag", "cardIndex": 4 },
        "advanceOn": { "on": "ackCovers", "cell": [6, 8] }
      },
      {
        "id": "plant-discard", "text": "我们先把这个粉植物移开——把它拖出户型图外面就行", "hand": "drag",
        "pointTo": { "kind": "ghost" },
        "gate": { "action": "drag", "cardIndex": 4 },
        "advanceOn": { "on": "selectionCleared" }
      },
      {
        "id": "demolish-on", "text": "想拿走已经放好的家具？先点「拆除」", "hand": "tap",
        "pointTo": { "kind": "button", "name": "拆除" },
        "gate": { "action": "demolishToggle" },
        "advanceOn": { "on": "demolishModeOn" }
      },
      {
        "id": "demolish-cell", "text": "再点一件已放的家具，它就会回到列表", "hand": "tap",
        "pointTo": { "kind": "lastPlaced" },
        "gate": { "action": "demolishCell" },
        "advanceOn": { "on": "removed" }
      },
      {
        "id": "demolish-off", "text": "再点一下「拆除」，退出拆除模式", "hand": "tap",
        "pointTo": { "kind": "button", "name": "拆除" },
        "gate": { "action": "demolishToggle" },
        "advanceOn": { "on": "demolishModeOff" }
      },
      {
        "id": "all-done", "text": "以上就是全部操作啦！现在试着把所有家具都摆进房间吧。", "hand": "tap",
        "pointTo": { "kind": "none" },
        "gate": { "action": "none" },
        "advanceOn": { "on": "confirm" }
      }
    ]
  }
}
